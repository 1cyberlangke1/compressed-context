{
  "name": "compressed-context",
  "version": "0.2.24",
  "description": "OpenCode 上下文管理插件：按需压缩、自包含摘要",
  "type": "module",
  "license": "MIT",
  "author": "1cyberlangke1",
  "homepage": "https://github.com/1cyberlangke1/compressed-context#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1cyberlangke1/compressed-context.git"
  },
  "bugs": {
    "url": "https://github.com/1cyberlangke1/compressed-context/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "context",
    "compression",
    "summarization",
    "llm"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "peerDependencies": {
    "@opencode/plugin": "^2.0.32",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:tui && pnpm build:tui",
    "build:tui": "bun scripts/build-tui.mjs",
    "prepack": "bun run build:tui",
    "test": "vitest run",
    "test:tui": "cd tui-test && bun test",
    "test:e2e:nudge": "bun scripts/e2e-nudge.mjs",
    "test:e2e:tool-loop": "bun scripts/e2e-tool-loop.mjs",
    "test:e2e:native-compaction": "bun scripts/e2e-native-compaction.mjs",
    "test:e2e:update": "bun scripts/e2e-update.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/plugin": "^2.1.2",
    "@opencode/theme": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "^26.6.5",
    "@xterm/headless": "^6.0.0",
    "eslint": "^10.13.0",
    "solid-js": "1.9.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "effect": "4.0.1",
    "jsonc-parser": "^3.3.1",
    "jsonrepair": "^3.15.0"
  }
}
